{
  "name": "keiri-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "keiri": "./scripts/keiri.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "keiri": "node scripts/keiri.mjs",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "verify:money-coach": "node --test src/domain/money-coach.test.ts src/lib/agent-read-auth.test.ts src/lib/money-snapshot-service.test.ts src/lib/money-write-service.test.ts src/repositories/scope.test.ts && npm run build",
    "test:accounting": "node --test src/domain/accounting.test.ts src/domain/documents.test.ts src/domain/bank.test.ts src/lib/bank-classifier.test.ts src/lib/google/rest.test.ts src/lib/webpush.test.ts src/lib/coalesce.test.ts src/lib/documents/agent-request.test.ts src/lib/documents/agent-update.test.ts src/domain/closing.test.ts src/domain/fiscal-year.test.ts src/lib/closing/freee-csv.test.ts src/lib/closing/trial-balance-csv.test.ts src/repositories/scope.test.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "icons": "node scripts/build-icon-font.mjs",
    "icons:check": "node scripts/build-icon-font.mjs --check"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "@vinext/cloudflare": "^1.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "material-symbols": "^0.45.1",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "vinext": "^1.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-ad79608dd",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "googleapis": "^182.0.0",
    "playwright": "^1.61.0",
    "prettier": "3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0"
  },
  "type": "module"
}
