# コピーして .env.local にし、値を入れる。空（""）の項目は未設定として扱われる。
# Cloudflare Workers をローカルで動かす（npm run dev:vinext）ときは、同じ内容を .dev.vars に置く。
# 本物の値は絶対にコミットしない（.env* と .dev.vars は .gitignore で除外済み）。

# スプレッドシートの接続コード。スプレッドシートのメニュー「keiri-app」で発行する。
# 空のまま npm run dev すると、デモデータで動く（保存されない）。本番では必須。
KEIRI_CONNECTION=""

# ── ログイン（任意）──
# パスワードの PBKDF2 の反復回数。20000〜100000 の整数で、既定は 20000。
# 上げると総当たりに強くなるが、Cloudflare Workers の無料プランの CPU 時間（10ms / 要求）を使い切りやすくなる。
# Workers は 100000 回を超える PBKDF2 を拒否する。範囲外や数字でない値は既定に戻る。
# 変えても既存のパスワードは有効で、次にパスワードを変えたときから新しい回数になる。
KEIRI_PASSWORD_ITERATIONS=""
# 本番以外で、かつ KEIRI_CONNECTION が空のときだけ、1 にすると、デモのデータ（保存されない）のまま、
# 本物のログインの流れ（/setup から）を試せる。/setup と /recover の接続コードには demo と入れる。本番では無視される。
KEIRI_DEMO_AUTH=""

# ── AI のキー（任意）──
# Gemini: 帳票のたたき台、領収書の読み取り、収支の改善提案
GEMINI_API_KEY=""
# TypeSafe の Jev: 銀行明細 CSV の列の読み取りと仕訳。TYPESAFE_MODEL の既定は jev-latest
TYPESAFE_API_KEY=""
TYPESAFE_MODEL=""
