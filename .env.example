# コピーして .env.local にし、自分の値を入れる。空（""）の項目は未設定として扱われる。
# Cloudflare Workers をローカルで動かす（npm run dev:vinext）ときは、同じ内容を .dev.vars に置く。
# 本物の値は絶対にコミットしない（.env* と .dev.vars は .gitignore で除外済み）。

# ── ログイン（本番では AUTH_SECRET が必須）──
# 最初の管理者。ユーザーが1人もいなくてもログインできる。
APP_LOGIN_ID=""
APP_LOGIN_PASSWORD=""
# ログインの Cookie に署名する鍵。16 文字以上のランダムな値を入れる（例: openssl rand -base64 32）。
# 空のままだと、開発中（npm run dev）は固定値で動く。本番では、未設定・16 文字未満なら
# すべてのリクエストを 500 で断り、next start はその場で終了する。
AUTH_SECRET=""

# ── Google Sheets バックエンド（サービスアカウント）──
# 3つ揃うと Sheets に切り替わる。空なら InMemory（デモデータ）で動く。
# InMemory のデータは再起動で消える。Cloudflare Workers では、リクエストのたびに消えることもある。
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# サービスアカウントの JSON キーにある private_key の値。改行は \n のまま1行で入れる
GOOGLE_PRIVATE_KEY=""
SHEETS_SPREADSHEET_ID=""
# 任意。帳票を自分のスプレッドシートの書式でも作りたいときに、テンプレートを指定する。
# 空なら、帳票の PDF はブラウザの中で組む。
DOCUMENT_TEMPLATE_SPREADSHEET_ID=""
DOCUMENT_TEMPLATE_SHEET_ID=""
DOCUMENT_OUTPUT_FOLDER_ID=""

# ── AI のキー（任意）──
# Gemini: 帳票のたたき台、領収書の読み取り、収支の改善提案
GEMINI_API_KEY=""
# TypeSafe の Jev: 銀行明細 CSV の列の読み取りと仕訳。TYPESAFE_MODEL の既定は jev-latest
TYPESAFE_API_KEY=""
TYPESAFE_MODEL=""
# 今のコードは読まない。別のモデルに差し替えるときの置き場
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── エージェント向け API（任意。空なら API は閉じる）──
# お金の読み取りは24文字以上、書き込みと書類作成は32文字以上。それぞれ別の値にする。
AGENT_READ_TOKEN=""
AGENT_WRITE_TOKEN=""
AGENT_DOCUMENTS_TOKEN=""

# ── Web プッシュ通知（任意）──
PUSH_SECRET=""
VAPID_SUBJECT=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ── ローカル専用のスクリプト（任意。サーバーには置かない）──
# scripts/freee.mjs（freee 会計 API）
FREEE_CLIENT_ID=""
FREEE_CLIENT_SECRET=""
# scripts/import-rakuten.mjs のログイン画面に出すヒント（パスワードは入れない）
RAKUTEN_ENAVI_USER=""
